{
  "name": "@dsh-external/dsh-session-trash",
  "description": "Crash-safe session trash for the DeepSeek Harness Web GUI with undo, restore, cross-tab sync, and guarded permanent purge",
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/panel.code.js",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node scripts/selftest.mjs && node scripts/hostflow.test.mjs && node scripts/settingsflow.test.mjs && node scripts/purgeflow.test.mjs && node scripts/clientbundle.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wzs010429/dsh-session-trash.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "trash",
    "web-gui"
  ]
}
